{
    "name": "vscode-pyenv",
    "displayName": "Python Environment (VSCode)",
    "description": "A Visual Studio Code extension to create the Python environment for the current workspace.",
    "version": "2.0.3",
    "publisher": "Solorzano-JuanJose",
    "icon": "icon/icon.png", 
    "repository": {
        "type": "git",
        "url": "https://github.com/JuanJoseSolorzano/VscodePythonEnvironment.git"
    },
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Testing"
    ],
    "activationEvents": [
        "onCommand:python-environment.setPythonEnvironment"
    ],
    "contributes": {
        "commands": [
            {
                "command": "python-environment.setPythonEnvironment",
                "title": "Create Python Environment"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "python-environment.setPythonEnvironment",
                    "when": "resourceScheme == 'file'",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Excluded Folders",
            "properties": {
                "ta-python-environment.excludedFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "out",
                        ".vscode",
                        ".git",
                        ".github",
                        "__pycache__"
                    ],
                    "description": "List of folders to exclude from the search for Python files."
                }
            }
        }
    },
    "extensionDependencies": [
        "ms-python.python"
    ],
    "main": "./dist/main.js",
    "files": [
        "resources/",
        "dist/main.js",
        "icon/",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "compile": "npm run check-types && node esbuild.js",
        "check-types": "tsc --noEmit",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "vscode:prepublish": "npm run package",
        "package": "npm run check-types && node esbuild.js --production"
    },
    "dependencies": {
        "@types/node": "^20.4.2"
    },
    "devDependencies": {
        "@types/vscode": "^1.105.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "typescript": "^6.0.3",
        "webpack": "^5.108.1",
        "webpack-cli": "^7.1.0"
    }
}
